# AWS Environment Configuration
# These settings will be used in production deployment

# Server Configuration
NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# AWS Amplify automatically provides these:
# AWS_REGION
# AWS_DEFAULT_REGION
# AWS_BRANCH
# AWS_APP_ID

# Project Tracker Configuration
PROJECT_TRACKER_ENV=aws
SCAN_DIRECTORIES_CONFIG=/tmp/amplify-directories.json

# Logging
LOG_LEVEL=info

# CORS Origins (update with your domain)
CORS_ORIGINS=https://your-domain.amplifyapp.com,https://your-custom-domain.com